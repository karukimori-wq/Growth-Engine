# Local development defaults.
# Mock mode is acceptable only for local/manual UI checks.
GROWTH_REPOSITORY_DRIVER=mock
AUDIT_LOG_REPOSITORY_DRIVER=mock
EVENT_PUBLISHER_DRIVER=mock

# Production persistence.
# Production must use database-backed Growth Repository persistence so Customer and Reservation
# records survive redeploys, browser changes, and re-login.
# Set GROWTH_REPOSITORY_DRIVER=postgres and configure at least one Postgres connection variable.
# Do not expose these values to the browser. Do not prefix with NEXT_PUBLIC_.
# GROWTH_REPOSITORY_DRIVER=postgres
# POSTGRES_URL=postgres://user:password@host:5432/database
# POSTGRES_PRISMA_URL=postgres://user:password@host:5432/database
# POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/database
# DATABASE_URL=postgres://user:password@host:5432/database

# Production owner sign-in.
# GROWTH_ENGINE_AUTH_SECRET=replace_with_long_random_secret
# GROWTH_ENGINE_OWNER_ACCESS_CODE=replace_with_private_owner_access_code

# Trusted server-to-server bridge used only by Velvet for Customer.Create/read display data.
# Configure the same secret in Velvet as GROWTH_ENGINE_INTEGRATION_SECRET.
# VELVET_INTEGRATION_SECRET=replace_with_long_random_secret

# Optional in local mock mode. Set in production Stripe webhook environments.
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
