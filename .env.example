# MVP foundation defaults.
# Keep these drivers on mock until production implementations are added.
GROWTH_REPOSITORY_DRIVER=mock
AUDIT_LOG_REPOSITORY_DRIVER=mock
EVENT_PUBLISHER_DRIVER=mock

# Trusted server-to-server bridge used only by Velvet for Customer.Create/read display data.
# Configure the same secret in Velvet as GROWTH_ENGINE_INTEGRATION_SECRET.
# VELVET_INTEGRATION_SECRET=replace_with_long_random_secret

# Optional in local mock mode. Set in production Stripe webhook environments.
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
